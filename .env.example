# ============================================================
#  Alcove Atelier — Environment Variables
#
#  Local dev: copy to `.env` and fill in.
#  Production: add these in Vercel → Project → Settings → Environment Variables.
#
#  Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
#  therefore PUBLIC. Everything else stays on the server — never expose it.
# ============================================================

# ------------------------------------------------------------
#  REQUIRED — the site will not work correctly without these
# ------------------------------------------------------------

# --- Supabase Postgres ---
# Supabase → Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction" pooler (port 6543) — used by the app at runtime.
#                  Keep ?pgbouncer=true&connection_limit=1 for serverless.
#   DIRECT_URL   = direct connection (port 5432) — used by the Prisma CLI for
#                  migrations only.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Public site URL (no trailing slash) ---
# Used for canonical URLs, sitemap, OG tags and payment redirects. Getting this
# wrong breaks SEO, so set it to the live domain before launch.
NEXT_PUBLIC_SITE_URL="https://alcoveatelier.co.ke"

# --- Admin dashboard (CMS) login ---
# REQUIRED IN PRODUCTION: with either missing, admin login is refused outright
# (no default password is ever used in production).
# Generate a secret with:  openssl rand -base64 32
ADMIN_PASSWORD="a-long-random-password"
ADMIN_SESSION_SECRET="a-different-long-random-string"

# ------------------------------------------------------------
#  Business contact (shown on the site — public)
# ------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER="2547XXXXXXXX"   # intl format, no "+"
NEXT_PUBLIC_PHONE="+2547XXXXXXXX"
NEXT_PUBLIC_EMAIL="hello@alcoveatelier.co.ke"

# ------------------------------------------------------------
#  Supabase Storage — product image uploads from /admin
#  Without these, the admin can still paste image URLs, but the
#  file picker will report that storage is not configured
#  (serverless filesystems are read-only).
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""                 # SERVER ONLY — bypasses row-level security
SUPABASE_STORAGE_BUCKET="product-images"     # must be a PUBLIC bucket

# ------------------------------------------------------------
#  Optional — features light up as keys are added
# ------------------------------------------------------------

# --- Search Console / Bing verification (public meta tags) ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Analytics ---
NEXT_PUBLIC_GA_ID=""                          # e.g. G-XXXXXXXXXX

# --- Order notification emails (Resend) ---
RESEND_API_KEY=""
ORDER_NOTIFY_EMAIL="orders@alcoveatelier.co.ke"

# --- M-Pesa (Safaricom Daraja STK Push) ---
# The storefront currently takes M-Pesa manually via Paybill, so these are only
# needed if STK Push is switched on later.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                            # Paybill/Till (Business Short Code)
MPESA_PASSKEY=""
MPESA_ENV="sandbox"                           # sandbox | production
MPESA_CALLBACK_URL="https://alcoveatelier.co.ke/api/checkout/mpesa/callback"
# Shared secret appended to the callback URL. REQUIRED IN PRODUCTION if STK Push
# is used — without it the callback refuses to mark orders paid, because anyone
# could otherwise post a fake "payment received".
MPESA_CALLBACK_TOKEN=""

# --- Card / PayPal (not offered at checkout — see README) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"                          # sandbox | live
